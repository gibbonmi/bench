# Node / npm
node_modules/
npm-debug.log*
*.tgz

# Go dev build — the repo-local dist/ the gate rebuilds (stamped, -trimpath) every
# run and the strangler router prefers. Never committed; the release workflow
# produces the shipped binaries into the platform packages instead.
dist/
.logs/
projects/gl-axi.md
# OS cruft
.DS_Store

# Claude Code user-local permissions — per-user, never shared; the tracked
# harness surface lives in .claude/skills/ and stays committed.
.claude/settings.local.json


# Bench shift scratch — created in the repo root during `bench shift`, cleaned on
# normal exit/interrupt; ignored so an unclean kill can't leave them to be committed.
.bench-objective
.bench-notes.md
research/

# Local design reference images — kept on disk, never committed.
ui_example/

# Repo-local profiles are tracked (see projects/benchkit.md) but excluded from the
# published package via package.json "files" — not ignored here.

# Capture inboxes — local working notes; drained through /bench-drain, never committed.
capture/IDEAS.md
capture/learnings.md

# Session handoff — local cold-start pin; the roadmap carries the shared next action.
capture/session-handoff.md
