# Node / npm
node_modules/
npm-debug.log*
*.tgz

# Go dev build — the repo-local dist/ the gate rebuilds (stamped, -trimpath) every
# run and the strangler router prefers. Never committed; the release workflow
# produces the shipped binaries into the platform packages instead.
dist/
projects/regroup.md
projects/gl-axi.md
# OS cruft
.DS_Store

# Python bytecode from the hook analyzer (git-guard.py)
__pycache__/

# Bench shift scratch — created in the repo root during `bench shift`, cleaned on
# normal exit/interrupt; ignored so an unclean kill can't leave them to be committed.
.bench-objective
.bench-notes.md
research/
# Repo-local profiles are tracked (see projects/benchkit.md) but excluded from the
# published package via package.json "files" — not ignored here.
