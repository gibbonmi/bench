              ]
            }
          ]
        },
        {
          "id": "FT392",
          "criteria": [
            {
              "id": "FT392.closure",
              "text": "bench gate --checkpoint \u003cspec\u003e --complete grades the tree that the landing publishes, composed through the landing's own delivery-closure transform, so a red that the closure creates refuses the checkpoint."
            }
          ],
          "sources": [
            {
              "id": "FT392",
              "path": "roadmap/FT392.md",
              "identity": "sha256:d5432f5de8095b777bfa66fa8c850c838b7cf0b28d13c3e0269fdc0cd3cfa002"
