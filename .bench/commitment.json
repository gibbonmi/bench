        {
          "id": "FT393",
          "criteria": [
            {
              "id": "FT393.registry",
              "text": "Every refusal of a write verb renders through one refusal-route registry, and each face declares a typed route and its agent or reviewer authority."
            },
            {
              "id": "FT393.reachable",
              "text": "A conformance check proves that every agent route passes the wired guards and that each producing fixture follows its route out of the refused face."
            }
          ],
          "sources": [
