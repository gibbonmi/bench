              }
            }
          ]
        },
        {
          "id": "FT402",
          "criteria": [
            {
              "id": "FT402.faster",
              "text": "The landing gate spends less time, and each changed test keeps its purpose and its failure detection."
            },
            {
              "id": "FT402.spread",
              "text": "A timing gain inside the recorded run-to-run spread counts as no change, and the build records each reverted attempt."
            },
            {
              "id": "FT402.remeasure",
              "text": "The build measures its timing targets again on the tmpfs base before it starts."
            }
          ],
          "sources": [
            {
              "id": "FT402",
              "path": "roadmap/FT402.md",
              "identity": "sha256:41d65fb4d12a47bd5dad654156e372ada8934839ed262686f76a7875fe230641"
            }
          ],
          "dependencies": [
            "FT409"
          ]
        },
        {
          "id": "FT379",
          "criteria": [
            {
              "id": "FT379.record-only-cycle",
              "text": "A record-only correction that changes a disposition consumes no repair cycle."
            },
            {
              "id": "FT379.evidence-confirmation",
              "text": "The review record has an evidence-only confirmation form that a biting coordinator probe satisfies, and the chunk checkpoint accepts that form in place of three fresh axes for a test-only repair delta."
            },
            {
              "id": "FT379.test-only-skip",
              "text": "A test-only repair whose coordinator probe bites closes through the evidence-only confirmation form and needs no confirming round."
            }
          ],
          "sources": [
            {
              "id": "FT379",
              "path": "roadmap/FT379.md",
              "identity": "sha256:c0f49651f4b07a9e9abb92b79fa939b282d2ec1c6664d61631d67eb9837a15ae"
            }
          ]
        },
        {
          "id": "FT405",
          "criteria": [
            {
              "id": "FT405.verb",
              "text": "bench record ticket \u003cslug\u003e --chunk \u003cid\u003e --excerpts \u003cdir\u003e records the plan amendment when the digest moved, freezes the chunk at HEAD, and records one verification entry for each planned requirement from a folder of excerpts named by requirement id."
            },
            {
              "id": "FT405.composition",
              "text": "The bench record ticket verb composes the shipped bench record assignment and bench record verification forms."
            },
            {
              "id": "FT405.repair-session",
              "text": "One repair session records verification for every ticket of its chunk."
            },
            {
              "id": "FT405.check-current",
              "text": "bench preflight evidence --check-current reports the dirty paths instead of a refusal."
            }
          ],
          "sources": [
            {
              "id": "FT405",
              "path": "roadmap/FT405.md",
              "identity": "sha256:b53533c8de03698aef67b2a7869cbc8c7058fa18c42f8af042e1c8ae09666832"
            }
          ]
        },
        {
          "id": "FT168-probe-batch",
          "criteria": [
            {
              "id": "FT168-probe-batch.batch",
              "text": "One bench probe call grades several mutants against one shared baseline run and one private build."
            },
            {
              "id": "FT168-probe-batch.packages",
              "text": "One bench probe call grades several packages in one private build."
            },
            {
              "id": "FT168-probe-batch.record-form",
              "text": "The spec stage of this slice decides how bench record imports a batch probe result, and FT318 owns that record form."
            },
            {
              "id": "FT168-probe-batch.open",
              "text": "The delivery closes no roadmap row, and the canary and failing-name faces stay on FT168."
            }
          ],
          "sources": []
        },
        {
          "id": "FT375-spec-staleness",
          "criteria": [
            {
              "id": "FT375-spec-staleness.rows",
              "text": "bench preflight build reports a drift row for each fenced path that changed from the spec's pinned commit to the source tip, a cited-symbol row, and a cited-test row."
            },
            {
              "id": "FT375-spec-staleness.skip",
              "text": "The build dispatches no staleness pass when every required supported row is green and the drift row is empty, and otherwise the manual pass audits only the drift, the red rows, and the unsupported claims."
            },
            {
              "id": "FT375-spec-staleness.open",
              "text": "The delivery closes no roadmap row, and FT375 keeps the faces that the staged spec does not name."
            }
          ],
          "sources": [],
          "deliverables": [
            {
              "source": {
                "id": "preflight-spec-staleness",
                "path": "specs/preflight-spec-staleness/spec.md",
                "identity": "sha256:b4f7e8acedc521247a9c59162217379c4b5b4572995f93649e13cacc48ba376d"
              }
            }
          ],
          "dependencies": [
            "FT293-ownership-closure"
          ]
        },
        {
          "id": "FT293-ownership-closure",
          "criteria": [
            {
              "id": "FT293-ownership-closure.proposal",
              "text": "bench preflight derives one closure proposal that names each required ownership path of a ticket with its source and its reason, and the proposal grants no approval, write, or dispatch authority."
            },
            {
              "id": "FT293-ownership-closure.fence",
              "text": "A fence expansion amends the approved spec fence and the ticket Writes line together, and the review preflight grades the spec fence."
            },
            {
              "id": "FT293-ownership-closure.callers",
              "text": "Preflight names each caller outside the ticket fence of a changed unexported helper, including the callers from before a move."
            },
            {
              "id": "FT293-ownership-closure.deletion",
              "text": "A deleted file's Writes entry carries a deletion marker that the preflight accepts."
            },
            {
              "id": "FT293-ownership-closure.premises",
              "text": "Before a charge, preflight verifies each supported spec premise against one committed source identity, and an unsupported premise stays a diagnostic or a charge refusal."
            },
            {
              "id": "FT293-ownership-closure.uncited",
              "text": "The breakdown preflight lists each uncited coverage row, and the rows-owned check still refuses an uncited row."
            },
            {
              "id": "FT293-ownership-closure.open",
              "text": "The delivery closes no roadmap row, and FT293 keeps the closure members that the staged spec does not name."
            }
          ],
          "sources": [],
          "deliverables": [
            {
              "source": {
                "id": "preflight-ownership-closure",
                "path": "specs/preflight-ownership-closure/spec.md",
                "identity": "sha256:84d26ede4104181b241626588a6a5faff395de00cd31c459f8ab9dfab2fa3ebb"
              }
            }
          ]
        },
        {
          "id": "FT380-plan-commit",
          "criteria": [
            {
              "id": "FT380-plan-commit.preflight-build",
              "text": "The guidance requires bench commit --preflight-build \u003cslug\u003e for each plan commit before the next dispatch."
            },
            {
              "id": "FT380-plan-commit.successor-delta",
              "text": "A plan commit after a chunk freeze joins the review delta of the successor chunk."
            },
            {
              "id": "FT380-plan-commit.chunk-table",
              "text": "The build preflight checks the chunk table against the coverage map, and a red check-floor row blocks the next charge and the review charge."
            },
            {
              "id": "FT380-plan-commit.open",
              "text": "The delivery closes no roadmap row, and the check before publication and the commit-lane floor stay open on FT380."
            }
          ],
          "sources": []
        },
        {
          "id": "FT411",
          "criteria": [
            {
              "id": "FT411.cut",
              "text": "Each test that the reviewer selects from the 2026-10-09 test-efficiency review tables is cut."
            },
            {
              "id": "FT411.probe",
              "text": "Before each cut, a probe proves that the subsuming test turns red on the same mutation."
            }
          ],
          "sources": [
            {
              "id": "FT411",
              "path": "roadmap/FT411.md",
              "identity": "sha256:39767ebe69c064d4dd2633f91096e0d888fb3bb1b2c04b9b9a7891a719d1950c"
            }
          ]
        },
        {
          "id": "FT409",
          "criteria": [
            {
              "id": "FT409.slowest",
              "text": "bench test reports the slowest tests of each package and the package elapsed time."
            },
            {
              "id": "FT409.timeout",
              "text": "bench test warns when the elapsed time of a package nears the go test timeout that the gate uses."
            }
          ],
          "sources": [
            {
              "id": "FT409",
              "path": "roadmap/FT409.md",
              "identity": "sha256:94e9d492c4862e15271ee301fe3a03216dc218ba7c00c22f40d930f7a21c65c8"
            }
          ]
        }
      ]
    }
