      "id": "quality-1",
      "outcomes": [
        {
          "id": "ADR26",
          "criteria": [
            {
              "id": "ADR26.adr",
              "text": "ADR 0026 records the default class order, the explicit reviewer order that governs it, and the out-of-scope rules of the delivery commitment."
            },
            {
              "id": "ADR26.retire",
              "text": "The roadmap-delivery-commitment spec folder and its review record are retired through a spec-retire landing."
            }
          ],
          "sources": [
            {
              "id": "FT389",
              "path": "roadmap/FT389.md",
              "identity": "sha256:a75c563407db1334fb21fc211ac62adba6612444e9b66591ef2eb29bbbc33a1a"
            }
          ],
