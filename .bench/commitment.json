    {
      "id": "quality-2",
      "outcomes": [
        {
          "id": "build-directions",
          "criteria": [
            {
              "id": "build-directions.no-mid-chunk-fold",
              "text": "The implement-spec guidance states that a build does not fold main into its branch in the middle of a chunk."
            },
            {
              "id": "build-directions.no-in-build-light-path",
              "text": "The implement-spec guidance states that a build dispatches no light-path fix while the build runs."
            },
            {
              "id": "build-directions.author-self-check",
              "text": "Before the first edit, the ticket author lists every place the change must reach: callers, tests, fixtures, and exports, and code that the author moves or merges keeps its error handling and validation."
            },
            {
              "id": "build-directions.witness-cap",
              "text": "The author charge keeps the witness cap and runs the witnesses through one bench test call with a repeated --package flag."
            },
            {
              "id": "build-directions.author-records",
              "text": "The ticket author records its own chunk entry and its verification entries."
            },
            {
              "id": "build-directions.parallel-axes",
              "text": "The review axes of a round run in parallel, and their findings go to one combined repair charge."
            },
            {
              "id": "build-directions.confirming-scope",
              "text": "A confirming round examines only the findings that it names."
            },
            {
              "id": "build-directions.step-log",
              "text": "The build log records each reviewer direction that saves a step."
            },
            {
              "id": "build-directions.FT410-last-chunk",
              "text": "The implement phase runs a chunk checkpoint gate only before a successor chunk."
            },
            {
              "id": "build-directions.FT410-complete",
              "text": "The final chunk of a build goes straight to final reconciliation and closes through the complete checkpoint alone."
            },
            {
              "id": "build-directions.open",
              "text": "The delivery leaves FT379 and FT369 open."
            }
          ],
          "sources": [
            {
              "id": "FT410",
              "path": "roadmap/FT410.md",
              "identity": "sha256:802bfd784abf9f0df90ec363b8d85f277b092cf2f1ce7044157728051b8a5b89"
            }
          ],
          "deliverables": [
            {
              "source": {
                "id": "build-directions",
                "path": "specs/build-directions/spec.md",
                "identity": "sha256:65d4c78f189356ab57657c587b67f18a03523a7e560b0620579b84b11215b73a"
              },
              "obligations": [
                "FT410"
              ]
            }
          ]
        },
        {
          "id": "FT258-merge-parent",
          "criteria": [
            {
              "id": "FT258-merge-parent.parent",
              "text": "When MERGE_HEAD exists, bench commit records the merge parent as the second parent of the commit."
            },
            {
              "id": "FT258-merge-parent.pending",
              "text": "bench commit never authors a one-parent commit while merge state is pending."
            },
            {
              "id": "FT258-merge-parent.open",
              "text": "The delivery closes no roadmap row, and the candidate-set forms --changed, --dry-run --changed, and --ticket stay on FT258."
            }
          ],
          "sources": [],
          "deliverables": [
            {
              "source": {
                "id": "commit-merge-parent",
                "path": "specs/commit-merge-parent/spec.md",
                "identity": "sha256:0d5ce814e2961df64529a78f557193ae58dce237cac568ad22263e54ab692bf0"
              }
            }
          ]
        },
        {
          "id": "FT395",
          "criteria": [
            {
              "id": "FT395.close-lands",
              "text": "A spec-stage close lands its staged spec and its deliverable binding on main before the handoff, and the handoff names the binding state."
            },
            {
              "id": "FT395.status-command",
              "text": "bench status prints the complete bench commitment start command, with the deliverable that the spec's Roadmap line and path derive."
            },
            {
              "id": "FT395.preflight-green",
              "text": "A ticket Writes line owns .bench/commitment.json, so the build preflight stays green after the binding."
            }
          ],
          "sources": [
            {
              "id": "FT395",
              "path": "roadmap/FT395.md",
              "identity": "sha256:5e901fe4e622cbce7d01f38123f3d116771c96f72cd2f72548f6c109f9093dc8"
            }
          ],
          "deliverables": [
            {
              "source": {
                "id": "spec-stage-binding",
                "path": "specs/spec-stage-binding/spec.md",
                "identity": "sha256:f4499d582585cd086bf5ef0e46002eff2dbc748ae28253b44883715b64b04ff8"
              },
              "obligations": [
                "FT395"
              ]
            }
          ]
        },
        {
          "id": "FT342-FT253",
          "criteria": [
            {
              "id": "FT342-FT253.lease",
              "text": "bench worktree land holds one lease in the intent ledger, keyed by the destination branch, from composition through publish, and a second landing on the same destination refuses with the owner's assignment id and a route that waits."
            },
            {
              "id": "FT342-FT253.window",
              "text": "While a chunked build is open, bench worktree land refuses a landing that is not that build's own landing outside a recorded chunk gap, and the refusal names the build and the gap to wait for."
            },
            {
              "id": "FT342-FT253.lifetime",
              "text": "The open-build window opens at bench commitment start and closes on completion, on bench commitment block, or on abandon."
            },
            {
              "id": "FT342-FT253.override",
              "text": "Only a recorded reviewer-owned override with a reason lets a landing move main after the last chunk's freeze, and an agent cannot grant that override to itself."
            },
            {
              "id": "FT342-FT253.fold",
              "text": "A record form accepts a fold-delta review in which only conflict-resolved hunks get review, and the final checks include the packages of the merged test files."
            },
            {
              "id": "FT342-FT253.route",
              "text": "A refusal for a moved destination names bench worktree merge and the landing rerun, not bench doctor."
            }
          ],
          "sources": [
            {
              "id": "FT342",
              "path": "roadmap/FT342.md",
              "identity": "sha256:8a0636b72dcccda2bdb2760f04179238cb36cc9befb8ae3c5cc47aa61a4c0db5"
            },
            {
