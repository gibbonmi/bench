                "FT373"
              ]
            }
          ]
        },
        {
          "id": "FT349",
          "criteria": [
            {
              "id": "FT349.floor",
              "text": "The ticket checkpoint refuses a commit whose checks omit root conformance, the tests of a package that the ticket Writes line derives, or the whole cmd/bench package when a public response or embed pattern changed."
            },
            {
              "id": "FT349.planned",
              "text": "The ticket checkpoint refuses a planned citation for a row that the committed ticket covers."
            }
          ],
          "sources": [
            {
              "id": "FT349",
              "path": "roadmap/FT349.md",
              "identity": "sha256:f4f89dbf1f4de267d1877ad2a3eb9ba7c410bebc7df46214d3fc573e6b51a268"
            }
          ],
          "deliverables": [
