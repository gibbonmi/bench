                "path": "specs/build-landing-window/spec.md",
                "identity": "sha256:bbb72629c91efb80a2d6536a53304aaf8a73577f05940bc26afef87bd6620dbf"
              },
              "obligations": [
                "FT342",
                "FT253"
              ]
            }
          ]
        },
        {
          "id": "FT354-durable-replace",
          "criteria": [
            {
              "id": "FT354-durable-replace.leaf",
              "text": "The internal/durablefile leaf replaces one regular file through an adjacent temporary file, synchronizes the file before the rename and the parent directory after it, and reports a failure after the rename with the statement that new bytes may already be visible."
            },
            {
              "id": "FT354-durable-replace.review",
              "text": "The review-record writer replaces its file through the internal/durablefile leaf, so it synchronizes the parent directory and returns an injected directory-sync failure."
            },
            {
              "id": "FT354-durable-replace.open",
              "text": "The delivery closes no roadmap row, and FT354 stays open for its other outcomes."
            }
          ],
          "sources": [],
          "deliverables": [
            {
              "source": {
                "id": "durable-file-replacement",
                "path": "specs/durable-file-replacement/spec.md",
                "identity": "sha256:b871086abe0d08e0674c031ec71ffe7711961dcaebe1d1d6a327d43d23e61fd5"
              }
            }
          ]
        },
        {
          "id": "FT354-durable-callers",
          "criteria": [
            {
              "id": "FT354-durable-callers.callers",
              "text": "Every remaining classified replacement caller replaces its file through the internal/durablefile leaf, and no migrated caller keeps its own temporary-file, synchronization, and rename sequence."
            },
            {
              "id": "FT354-durable-callers.preserved",
              "text": "Each migrated caller keeps its payload, mode, validation, destination authority, sentinel translation, and recovery policy, and each caller failure has a witness."
            },
            {
              "id": "FT354-durable-callers.open",
              "text": "The delivery closes no roadmap row, and FT354 stays open for its other outcomes."
            }
          ],
          "sources": [],
          "deliverables": [
