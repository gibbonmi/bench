              },
              "obligations": [
                "FT391"
              ]
            }
          ]
        },
        {
          "id": "FT376",
          "criteria": [
            {
              "id": "FT376.trace",
              "text": "Before the first review charge, the spec stage traces each pin row operator, each unexported entry read, and each derived expectation to its grader."
            },
            {
              "id": "FT376.consolidation",
              "text": "A spec that consolidates repeated rules maps each changed old-rule and new-rule cell to an acceptance row, a flagged addition, or a Won't handle line."
            },
            {
              "id": "FT376.quantified",
              "text": "Before the first review charge, the spec author checks every quantified obligation at each affected site and across all tickets."
            },
            {
              "id": "FT376.callers",
              "text": "The caller sweep runs bench consumers for each changed function, including unexported functions."
            },
            {
              "id": "FT376.digests",
              "text": "For each new workflow step, the spec author traces every write through the digests that later checkpoints compare."
            }
          ],
          "sources": [
            {
              "id": "FT376",
              "path": "roadmap/FT376.md",
              "identity": "sha256:2d5a52f6bf9e764cf1511395b052a8447160c4680300cf1a2494d7ac300df4f4"
            }
          ],
          "deliverables": [
            {
              "source": {
