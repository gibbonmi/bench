#!/usr/bin/env bash
# This is the Bench harness adapter for OpenCode. It maps the shift prompt, read
# from stdin, to OpenCode's noninteractive mode.
#
# The line binds the model to the declared line. In a routed repo — .bench/lines.env
# present — BENCH_MODEL must name a bound tier. Otherwise `bench resolve-model`
# refuses with exit 1, and this adapter refuses to launch. See
# .bench/lib/resolve-bench.sh and BENCH-reference.md, "Harness adapter for the shift
# loop".
#
# The adapter fails closed when the wrapper resolver or the core is unreachable. An
# unguarded passthrough in a routed repo is silent de-enforcement.
#
# The loop pipes the prompt on stdin for the other harnesses, but `opencode run`
# documents only a positional prompt, as of 2026-07-20. This adapter therefore reads
# stdin into a variable and passes it positionally with `--`, to keep a dash-leading
# prompt out of flag parsing.
#
# That final-hop argv exposure is the documented residual limitation. It will drop
# once opencode documents a stdin contract. An unbound opencode column refuses at the
# core, so an unadopted harness fails closed instead of borrowing another harness's
# column.
_lib="$(dirname "$0")/../lib/resolve-bench.sh"
[ -f "$_lib" ] || { echo "bench adapter: wrapper resolver missing at $_lib — refusing to run unguarded" >&2; exit 1; }
# shellcheck source=../lib/resolve-bench.sh
. "$_lib"
_cmd="$(bench_resolve_wrapper)" || { echo "bench adapter: bench core not found — refusing to run unguarded" >&2; exit 1; }
model="$("$_cmd" resolve-model --harness opencode)" || exit 1
prompt="$(cat)"
if [ -n "$model" ]; then
  exec opencode run --model "$model" -- "$prompt"
fi
exec opencode run -- "$prompt"
