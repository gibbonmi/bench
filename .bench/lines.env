# Tier -> model binding for the line (invariant #2). Machine-readable source of
# truth consumed by .bench/hooks/check-agent-line.sh and .bench/adapters/*; the
# narrative lives in projects/<name>.md "Lines". Refresh candidates with
# `bench models`. Exact model ids only — enforcement compares exact strings.
BENCH_TIER_TOP=claude-fable-5
BENCH_TIER_MID=claude-opus-4-8
BENCH_TIER_CHEAP=claude-sonnet-4-6
# Harness aliases that bind to a tier (Claude Code's Agent tool only speaks
# aliases). BENCH_ALIAS_CHEAP is deliberately undeclared: bare `sonnet`
# resolves to Sonnet 5, which is out of rotation — so it stays denied.
BENCH_ALIAS_TOP=fable
BENCH_ALIAS_MID=opus
