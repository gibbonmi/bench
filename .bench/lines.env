# Tier -> model binding for the line (invariant #2). Values are reviewer-owned
# opaque safe model-id tokens; bench models is advisory discovery, not validation.
# Machine-readable source of truth consumed by .bench/hooks/check-agent-line.sh
# and .bench/adapters/*; narrative binding lives in projects/<name>.md "Lines".
# Enforcement compares exact strings and does not ask a provider whether an id exists.
BENCH_TIER_TOP=gpt-5.6-sol
BENCH_TIER_MID=gpt-5.6-terra
BENCH_TIER_CHEAP=gpt-5.6-luna
# Harness aliases that bind to a tier (Claude Code's Agent tool only speaks
# aliases). Fable, opus, and sonnet select Claude Code's corresponding top,
# mid, and cheap tiers; they are separate from the Codex model ids above.
BENCH_ALIAS_TOP=fable
BENCH_ALIAS_MID=opus
BENCH_ALIAS_CHEAP=sonnet
