# Harness x tier binding for the line (invariant #2). Tier is the only shared
# identity: each harness names its own column and no family is canonical. Values
# are reviewer-owned opaque safe model-id tokens; bench models is advisory
# discovery, not validation. Machine-readable source of truth consumed by
# .bench/hooks/check-agent-line.sh and .bench/adapters/*; narrative binding lives
# in projects/<name>.md "Lines". Enforcement compares exact strings and does not
# ask a provider whether an id exists.
BENCH_CODEX_TOP=gpt-5.6-sol
BENCH_CODEX_MID=gpt-5.6-terra
BENCH_CODEX_CHEAP=gpt-5.6-luna
# Claude Code's Agent tool addresses models by these tokens; they are this
# harness's own column, not a translation of the Codex ids above.
BENCH_CLAUDE_TOP=fable
BENCH_CLAUDE_MID=opus
BENCH_CLAUDE_CHEAP=sonnet
# OpenCode is unadopted here: its column is deliberately unbound, so its adapter
# refuses to launch rather than guessing a family. Binding it means adding
# BENCH_OPENCODE_TOP/MID/CHEAP as provider-qualified ids.
