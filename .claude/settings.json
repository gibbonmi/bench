{
  "$comment": "Project settings for Bench. WorktreeCreate/WorktreeRemove route Claude's native lifecycle through the shared Bench core. SessionStart prints the ambient dashboard; Stop enforces the completion oracle during a shift; PreToolUse guards destructive Git and delegated model tiers.",
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.bench/hooks/worktree-lifecycle.sh", "args": ["create"] }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.bench/hooks/worktree-lifecycle.sh", "args": ["remove"] }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.bench/hooks/session-start.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.bench/hooks/stop.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.bench/hooks/block-dangerous-git.sh" }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.bench/hooks/check-agent-line.sh" }
        ]
      }
    ]
  }
}
