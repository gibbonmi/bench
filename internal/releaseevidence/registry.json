{
  "verify": ["gate", "race", "vet", "vulnerability", "artifacts", "smoke"],
  "publish_before": ["identity", "ancestry"],
  "publish_only": ["changelog"],
  "evidence_inputs": ["go.mod", "go.sum", "internal/releaseevidence/registry.json", "internal/releaseevidence/requirements.json"],
  "phases": {
    "gate": {"handler":"external", "argv":["{root}/bin/bench.sh", "gate"], "inputs":["bin/bench.sh", ".bench/gate.sh"]},
    "race": {"handler":"external", "argv":["go", "test", "-race", "-count=1", "./..."], "tools":["go"], "exact_toolchain":true},
    "vet": {"handler":"external", "argv":["go", "vet", "./..."], "tools":["go"], "exact_toolchain":true},
    "vulnerability": {"handler":"scanner", "tools":["govulncheck"]},
    "artifacts": {"handler":"external", "argv":["bash", "{root}/scripts/build-artifacts.sh", "{root}", "{root}/dist/artifacts"], "tools":["bash", "node", "npm"], "inputs":["scripts/build-artifacts.sh", "scripts/build-offline-archives.sh", "scripts/assemble-offline-archive.mjs", "scripts/release-plan.mjs", "scripts/release-plan.json", "scripts/write-deterministic-archive.mjs", "scripts/compare-artifacts.sh", "scripts/native-proof.sh", "scripts/aggregate-native-proofs.sh", "scripts/build-release-evidence.mjs", "scripts/go-build.sh", "scripts/go-build.inputs", ".bench/consumer-payload.json", "package.json"]},
    "smoke": {"handler":"external", "argv":["bash", "{root}/scripts/smoke-artifacts.sh", "{root}/dist/artifacts"], "tools":["bash", "node", "npm"], "inputs":["scripts/smoke-artifacts.sh", "scripts/smoke-offline.sh", "scripts/verify-release-artifact.mjs", "scripts/offline-network-sentinel.cjs", "scripts/offline-registry.mjs", "scripts/release-plan.mjs", "scripts/release-plan.json", "package.json"], "requires":["artifacts"]},
    "identity": {"handler":"identity"},
    "ancestry": {"handler":"ancestry"},
    "changelog": {"handler":"changelog"}
  }
}
