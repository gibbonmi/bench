{
  "hooks": {
	"SessionStart": [
	  {
		"hooks": [
		  {
			"type": "command",
			"command": "\"$(git rev-parse --show-toplevel)/.bench/hooks/session-start.sh\"",
			"statusMessage": "Resuming Bench context"
		  }
		]
	  }
	],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.bench/hooks/stop.sh\"",
            "statusMessage": "Checking Bench gate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.bench/hooks/block-dangerous-git.sh\"",
            "statusMessage": "Checking git safety"
          },
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.bench/hooks/block-bench-follow-on.sh\"",
            "statusMessage": "Checking Bench response safety"
          }
        ]
      }
    ]
  }
}
