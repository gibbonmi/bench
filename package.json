{
  "name": "redbench",
  "version": "0.2.0",
  "description": "A harness-agnostic agent-development workflow: a planning pipeline plus a gated autonomous loop, where an external gate \u2014 never the model \u2014 decides when work is done. Works with Claude Code, Codex, and other AGENTS.md harnesses.",
  "repository": "git+https://github.com/gibbonmi/bench.git",
  "homepage": "https://github.com/gibbonmi/bench#readme",
  "bugs": "https://github.com/gibbonmi/bench/issues",
  "author": "gibbonmi",
  "bin": {
    "bench": "bin/bench.sh",
    "redbench": "bin/bench.sh"
  },
  "scripts": {
    "prepare": "bash scripts/go-build.sh \"$PWD\" dist/bench",
    "postinstall": "bash bin/bench-postinstall.sh"
  },
  "files": [
    "bin/",
    "cmd/",
    "dist/",
    "go.mod",
    "go.sum",
    "internal/",
    "!cmd/**/*_test.go",
    "!internal/**/*_test.go",
    "projects/gl-axi.md",
    "projects/regroup.md",
    "README.md",
    ".agents/",
    ".bench/BENCH.md",
    ".bench/BENCH-reference.md",
    ".bench/adapters/",
    ".bench/hooks/",
    ".bench/lib/",
    ".claude/README.md",
    ".claude/settings.json",
    ".codex/hooks.json",
    "CHANGELOG.md",
    "scripts/go-build.sh"
  ],
  "keywords": [
    "claude-code",
    "codex",
    "agents",
    "agentic",
    "tdd",
    "workflow",
    "ai",
    "llm"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "license": "MIT"
}
